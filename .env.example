# Backend API URL - use localhost for local dev, your Railway URL for production
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=https://arete-app-production.up.railway.app

# Claude API key is now on the server - see server/.env.example
# EXPO_PUBLIC_CLAUDE_API_KEY=  <-- no longer needed in the app

# Supabase
EXPO_PUBLIC_SUPABASE_URL=your_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# RevenueCat public SDK keys (mobile in-app purchases). These are designed to
# ship in the app binary — the secret key belongs on the server only.
# Core SDK only: do NOT add react-native-purchases-ui, which is what broke the
# New Architecture build in May 2026.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
