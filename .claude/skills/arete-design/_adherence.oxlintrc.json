{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/agora/**",
              "components/cabinet/**",
              "components/chat/**",
              "components/data/**",
              "components/display/**",
              "components/editorial/**",
              "components/forms/**",
              "components/icons/**",
              "components/navigation/**",
              "components/overlay/**",
              "ui_kits/academy_web/**",
              "ui_kits/mobile_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Playfair Display|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Playfair Display, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcademyButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<AcademyButton> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcademyButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline)$/]",
        "message": "<AcademyButton> variant must be one of 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcademyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|children|style|key|ref|className|style|children)$/]",
        "message": "<AcademyCard> doesn't accept that prop. Declared props: kicker, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:stoics|warriors|athletes|builders|writers|spiritual|direct|firm|gentle|gold|outline|locked)$/]",
        "message": "<Badge> tone must be one of 'stoics' | 'warriors' | 'athletes' | 'builders' | 'writers' | 'spiritual' | 'direct' | 'firm' | 'gentle' | 'gold' | 'outline' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: title, subtitle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|fullWidth|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, fullWidth, icon, children."
      },
