# ───────────────────────────────────────────────────────────────────────────
# Arete backend (server/index.js) environment variables.
# Copy to .env for local dev. On Railway, set these in each service's Variables
# tab — they are NOT read from the repo or baked into the image.
# ───────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────
# Without CLAUDE_API_KEY the server still boots but every Claude endpoint
# returns HTTP 500 "Server configuration error: CLAUDE_API_KEY not set".
CLAUDE_API_KEY=sk-ant-api03-your-key-here
# OpenAI: RAG embeddings + any gpt-* counselor models. RAG silently returns no
# passages without it; gpt counselors fail. Treat as required for full function.
OPENAI_API_KEY=sk-proj-your-key-here
SUPABASE_URL=your_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Optional ──────────────────────────────────────────────────────────────
# PORT — Railway sets this automatically; only needed for local overrides.
PORT=3000
# Alternate counselor LLM providers. Absent key → that provider's clients are
# null and routing falls back to the default Claude model (never errors).
GEMINI_API_KEY=
XAI_API_KEY=
# Resend — transactional email for shared-session invites. Absent → invites are
# still created, email send is skipped.
RESEND_API_KEY=
INVITE_FROM_EMAIL=Arete <noreply@pursuearete.com>
# Public base URL used in invite links (has a sane production default).
RAILWAY_PUBLIC_URL=https://arete-app-production.up.railway.app
# Parallel Cabinet feature flags.
PARALLEL_CABINET_ENABLED=false
PARALLEL_CABINET_ALLOWLIST=
