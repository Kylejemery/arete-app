# Moltbook. NOTE: keep the www. Without it the redirect strips the Authorization header.
MOLTBOOK_BASE=https://www.moltbook.com/api/v1
MOLTBOOK_API_KEY=moltbook_xxx
MOLTBOOK_AGENT_NAME=Arete

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
COMPOSE_MODEL=claude-sonnet-5
TRIAGE_MODEL=claude-haiku-4-5-20251001

# Read-only MCP server over the Arete corpus (served by the main API server,
# server/routes/corpus-mcp.js). Token must match ARETE_MCP_TOKEN on that service.
ARETE_MCP_URL=https://arete-app-production.up.railway.app/mcp/corpus
ARETE_MCP_TOKEN=

# Supabase (service role, this process only)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=xxx

# Loop
TICK_MINUTES=30
MAX_ACTIONS_PER_DAY=12
