# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo

# Next.js build output (regenerated on every build; never commit)
.next/

app-example

# generated native folders
/ios
/android

# Google Play service account key (contains sensitive credentials — never commit)
google-play-service-account.json

.claude/worktrees/

# corpus source texts (large, not committed)
academy/corpus-ingestion/source_texts/*.txt
.vercel

# OMC atomic-write temp files & locks (transient, must never be tracked)
**/.omc/**/*.tmp.*
**/.omc/*.tmp.*
.omc/**/*.tmp.*
**/.omc/project-memory.json.lock
.omc/project-memory.json.lock

# Per-machine Claude Code local settings (may contain tokens) — never track
.claude/settings.local.json
