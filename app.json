{
  "expo": {
    "name": "Arete",
    "slug": "Arete",
    "version": "1.3.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arete",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "VAAKMM3C9G",
      "bundleIdentifier": "com.kylejemery.areteapp",
      "buildNumber": "36",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Arete uses notifications to prompt your morning and evening routines and keep you accountable to your goals.",
        "NSMicrophoneUsageDescription": "Arete does not directly use the microphone. This permission is required by an underlying framework dependency.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kylejemery.areteapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "_comment_ios26_patch": "Patches RCTTurboModule.mm for iOS 26 SIGABRT fix. Remove when expo/expo#44606 is resolved.",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e",
          "dark": {
            "backgroundColor": "#1a1a2e"
          }
        }
      ],
      "./plugins/withRCTTurboModulePatch",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-localization",
      "expo-sharing",
      [
        "react-native-device-activity",
        {
          "appleTeamId": "VAAKMM3C9G",
          "appGroup": "group.com.kylejemery.areteapp"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84e0593d-d728-4e1a-b522-f8d51ce8a069"
      }
    },
    "owner": "kjemery",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/84e0593d-d728-4e1a-b522-f8d51ce8a069"
    }
  }
}
