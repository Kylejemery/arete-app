{
  "$schema": "arete-design-tokens/v1",
  "brand": {
    "name": "Arete",
    "gold": "#c9a84c",
    "goldLight": "#e3c77a",
    "goldDeep": "#9a7a32"
  },
  "surfaces": {
    "app": {
      "bg": "#1a1a2e",
      "surface": "#16213e",
      "surfaceDeep": "#0d1526",
      "surfaceRaised": "#1f2a4a",
      "border": "#2a3a5c",
      "hairline": "rgba(201,168,76,0.13)"
    },
    "web": {
      "bg": "#0f1724",
      "surface": "rgba(255,255,255,0.04)",
      "surfaceSolid": "#161f2e",
      "border": "rgba(255,255,255,0.08)",
      "borderSolid": "#2a3a5c"
    },
    "academy": {
      "bg": "#0a1628",
      "surface": "#0f1e38",
      "card": "#111d30",
      "border": "#1e3258"
    }
  },
  "text": {
    "app": { "primary": "#ffffff", "body": "#e0e0e0", "warm": "#e0d5b5", "muted": "#888888", "faint": "#555555" },
    "web": { "primary": "#e6eef8", "muted": "#9aa0a6" },
    "academy": { "primary": "#f5edd6", "parchment": "#e8d9b0", "muted": "#7a8fa6" },
    "library": { "ivory": "#f4ead5", "text": "#e8e4d6", "muted": "#8a8b8e" }
  },
  "gold_alpha": {
    "0.05": "rgba(201,168,76,0.05)", "0.09": "rgba(201,168,76,0.09)", "0.13": "rgba(201,168,76,0.13)",
    "0.15": "rgba(201,168,76,0.15)", "0.2": "rgba(201,168,76,0.2)", "0.27": "rgba(201,168,76,0.27)",
    "0.33": "rgba(201,168,76,0.33)", "0.4": "rgba(201,168,76,0.4)", "0.53": "rgba(201,168,76,0.53)"
  },
  "semantic": {
    "success": "#4caf50",
    "danger": "#ff4444",
    "dangerSoft": "#f87171",
    "eveningBlue": "#4a6fa5",
    "insightPurple": "#b39ddb",
    "overBudget": "#e08a4c",
    "underBudget": "#7cb87c"
  },
  "counselor_categories": {
    "stoics":    { "bg": "rgba(201,168,76,0.2)", "text": "#c9a84c" },
    "warriors":  { "bg": "rgba(239,68,68,0.2)",  "text": "#fca5a5" },
    "athletes":  { "bg": "rgba(59,130,246,0.2)", "text": "#93c5fd" },
    "builders":  { "bg": "rgba(34,197,94,0.2)",  "text": "#86efac" },
    "writers":   { "bg": "rgba(168,85,247,0.2)", "text": "#d8b4fe" },
    "spiritual": { "bg": "rgba(99,102,241,0.2)", "text": "#a5b4fc" }
  },
  "challenge_levels": {
    "direct": { "bg": "rgba(239,68,68,0.15)", "text": "#f87171" },
    "firm":   { "bg": "rgba(234,179,8,0.15)", "text": "#fde047" },
    "gentle": { "bg": "rgba(34,197,94,0.15)", "text": "#86efac" }
  },
  "typography": {
    "app": {
      "family": "System (SF Pro on iOS, Roboto on Android)",
      "display": { "size": 72, "weight": 700, "tracking": 4, "use": "focus timer" },
      "hero": { "size": 52, "weight": 700, "use": "streak count" },
      "screenTitle": { "size": 26, "weight": 700, "color": "gold" },
      "name": { "size": 32, "weight": 700, "color": "white" },
      "cardTitle": { "size": 16, "weight": 700 },
      "body": { "size": 15, "lineHeight": 22 },
      "bodyLoose": { "size": 15, "lineHeight": 24, "use": "counselor replies" },
      "quote": { "size": 14, "lineHeight": 22, "style": "italic" },
      "caption": { "size": 12 },
      "meta": { "size": 11 },
      "kicker": { "size": 10, "weight": 700, "tracking": 1.2, "transform": "uppercase", "color": "gold" },
      "eyebrow": { "size": 11, "weight": 700, "tracking": 3, "transform": "uppercase", "color": "gold" }
    },
    "web": {
      "serif": "Cormorant Garamond, Georgia, serif",
      "sans": "Inter, system-ui, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "academy": {
      "serif": "Playfair Display, Georgia, serif",
      "sans": "Inter, system-ui, sans-serif",
      "librarySerif": "Cormorant Garamond, Georgia, serif"
    }
  },
  "radii": { "xs": 4, "sm": 6, "chip": 8, "button": 10, "card": 12, "cardLg": 14, "panel": 16, "sheet": 18, "hero": 20, "pill": 999 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "screen": 25, "section": 28 },
  "borders": { "hairline": 1, "selected": 2, "accentRule": 3 },
  "iconography": { "set": "Ionicons (outline variants)", "tabs": ["home-outline","sunny-outline","moon-outline","mic-outline","book-outline","library-outline","newspaper-outline","trophy-outline"] }
}
