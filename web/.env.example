# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Service role key — bypasses RLS. Server-side only, never NEXT_PUBLIC_.
# The subscriptions table and the entitlement columns on profiles
# (tier, is_premium) have no client write policies, so the Stripe webhook
# can only grant a subscription through this key.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Billing routes call requireEnv() on each of these and throw if unset, so a
# missing value fails the request loudly rather than silently not charging.
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen` locally, or the endpoint's signing secret in the
# Stripe dashboard once the webhook is registered.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ids (price_..., NOT product ids prod_...). These map to tiers in
# src/app/api/stripe-webhook/route.ts — monthly and yearly both grant
# 'premium'; pro grants 'pro'.
STRIPE_PRICE_MONTHLY=price_...   # $9.99/mo
STRIPE_PRICE_YEARLY=price_...    # $79.99/yr
STRIPE_PRICE_PRO=price_...       # $19.99/mo

# ─── RevenueCat (mobile IAP) ─────────────────────────────────────────────────
# Shared secret sent as the Authorization header on the RevenueCat webhook.
# Set the identical value on the webhook in the RevenueCat dashboard; the
# route rejects anything else, so a missing/mismatched value blocks all grants.
REVENUECAT_WEBHOOK_SECRET=your_shared_secret

# Deploy nudge: env vars changed 2026-08-28 (STRIPE_SECRET_KEY swap) — safe to delete.
