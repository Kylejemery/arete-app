# ─── Arete Academy — Environment Variables ──────────────────────────────────
# Set these in the Vercel project (Production) — or .env.local for local dev.
# Never commit real values to git.

# ─── Admin access ───────────────────────────────────────────────────────────
# Only this email can reach /admin and the generate/schedule APIs.
# Both must be the same address you log into the academy site with.
ADMIN_EMAIL=your@email.com
NEXT_PUBLIC_ADMIN_EMAIL=your@email.com   # client-side gate on the /admin page

# ─── Core services ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...             # powers the "Generate posts" button

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...         # server-only; RAG dashboard + post scheduler

NEXT_PUBLIC_SITE_URL=https://academy.pursuearete.com   # used to build the LinkedIn redirect URI

# ─── Direct social posting ──────────────────────────────────────────────────
# LinkedIn, Bluesky and X post directly via their APIs (no Buffer).

# LinkedIn — from the OAuth flow at /api/linkedin-callback (scope w_member_social).
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...
LINKEDIN_ACCESS_TOKEN=...
LINKEDIN_AUTHOR_URN=urn:li:person:xxxxxxxx

# Bluesky — handle (no leading @) + an App Password (Settings → App Passwords).
BLUESKY_HANDLE=you.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# BLUESKY_SERVICE=https://bsky.social   # only if using a custom PDS

# X / Twitter — OAuth 1.0a user context. From the X developer portal,
# app must be set to Read and Write before generating the access token/secret.
X_API_KEY=...            # Consumer Keys → API Key
X_API_SECRET=...         # Consumer Keys → API Key Secret
X_ACCESS_TOKEN=...       # Authentication Tokens → Access Token
X_ACCESS_SECRET=...      # Authentication Tokens → Access Token Secret

# ─── Scheduled posting ──────────────────────────────────────────────────────
# Shared secret between Vercel and the Railway post-scheduler cron service.
# Authorizes calls to /api/cron/post-due. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=...

# ─── Buffer (legacy / optional) ─────────────────────────────────────────────
# No longer used for LinkedIn/Bluesky/X (those post directly). Only needed if
# you wire Instagram / Threads / Facebook, which still route through Buffer.
# BUFFER_ACCESS_TOKEN=bt_xxxxxxxxxxxxxxxxxx
# BUFFER_PROFILE_INSTAGRAM=xxxxxxxxxxxxxxxxxxxxxxxx
# BUFFER_PROFILE_THREADS=xxxxxxxxxxxxxxxxxxxxxxxx
# BUFFER_PROFILE_FACEBOOK=xxxxxxxxxxxxxxxxxxxxxxxx
