# ─── Arete Admin — Environment Variables ───────────────────────────────────
# Add these to your Vercel project settings (or .env.local for dev)
# Never commit actual values to git

# Your email address — only this user can access /admin
ADMIN_EMAIL=your@email.com
NEXT_PUBLIC_ADMIN_EMAIL=your@email.com   # used client-side for the auth check

# Anthropic — already in your env, just confirming the name
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — already in your env
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Buffer ─────────────────────────────────────────────────────────────────
# 1. Go to https://buffer.com/developers/apps and create an app
# 2. Copy the access token here
BUFFER_ACCESS_TOKEN=bt_xxxxxxxxxxxxxxxxxx

# 3. Connect your social accounts in Buffer's UI, then find each profile ID:
#    GET https://api.bufferapp.com/1/profiles.json?access_token=YOUR_TOKEN
#    Copy the "id" field for each connected account

BUFFER_PROFILE_X=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_LINKEDIN=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_INSTAGRAM=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_THREADS=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_BLUESKY=xxxxxxxxxxxxxxxxxxxxxxxx
BUFFER_PROFILE_FACEBOOK=xxxxxxxxxxxxxxxxxxxxxxxx
